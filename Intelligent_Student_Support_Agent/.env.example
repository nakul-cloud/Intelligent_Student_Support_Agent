# ==========================================
# Intelligent Student Support Agent Settings
# ==========================================

# --- LLM Provider (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings (HuggingFace sentence-transformers local model) ---
OPENAI_API_KEY=optional_if_using_local_embeddings
EMBEDDING_MODEL=Orange/orange-nomic-v1.5-1536
EMBEDDING_DIMENSIONS=1536

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://localhost:6333
SIMILARITY_THRESHOLD=0.7
TOP_K_CHUNKS=3

# --- Dynamic RAG Chunking Configuration ---
CHUNK_TARGET_CHARS=1800
CHUNK_OVERLAP_CHARS=200

# --- Relational Database (PostgreSQL Async) ---
DATABASE_URL=postgresql+asyncpg://student_agent:student_agent_dev@localhost:5432/student_support_db

# --- Cache / Short-Term Memory (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RAG Ingestion Document Path ---
HANDBOOK_PATH=data/student_handbook.pdf

# --- Observability (LangSmith & Local Tracer) ---
ENABLE_LANGSMITH=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=student-support-agent

# --- Server & Runtime Environment ---
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
