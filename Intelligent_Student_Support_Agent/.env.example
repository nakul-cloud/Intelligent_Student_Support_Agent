# ==========================================
# Intelligent Student Support Agent Settings
# ==========================================

# --- LLM Provider (Groq / OpenAI-compatible Wire Protocol) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=your_openai_api_key_here
AGENT_MAX_TURNS=6
AGENT_TEMPERATURE=0.1

# --- Local Embeddings (HuggingFace SentenceTransformers) ---
EMBEDDING_MODEL=Orange/orange-nomic-v1.5-1536
EMBEDDING_DIMENSIONS=1536

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=student_handbook
SIMILARITY_THRESHOLD=0.7
TOP_K_CHUNKS=3

# --- Dynamic RAG Chunking Configuration ---
CHUNK_TARGET_CHARS=1800
CHUNK_OVERLAP_CHARS=200

# --- Relational Database (PostgreSQL Async) ---
DATABASE_URL=postgresql+asyncpg://student_agent:student_agent_dev@localhost:5432/student_support_db

# --- Cache / Short-Term Memory (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Paths & Domain Configurations ---
HANDBOOK_PATH=data/student_handbook.pdf
TRACES_DIR=traces
TICKET_PREFIX=TICK-

# --- Observability (Optional LangSmith Remote Dashboard) ---
ENABLE_LANGSMITH=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=student-support-agent

# --- Authentication (JWT & Security) ---
JWT_SECRET=your-super-secret-jwt-key-256-bit-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# --- Two-Tier Memory Configuration ---
REDIS_MEMORY_KEY_PREFIX=student_memory:
REDIS_MEMORY_TTL_SECONDS=86400

# --- Privacy & Safety Settings ---
SENSITIVE_KEYWORDS_STR=password,otp,pin,cvv,credit_card,card_number,secret,ssn,token,bank,upi
SENSITIVE_ACTIONS_STR=update_contact,request_fee_waiver,update_address,scholarship_appeal

# --- Server & Runtime Environment ---
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
