# ==============================================================================
# Justfile - Intelligent Student Support Agent Task Automation
# ==============================================================================

set windows-shell := ["powershell.exe", "-NoProfile", "-Command"]

# Default recipe: display help
default:
    @just --list

# --- Infrastructure (Docker) ---
# Start Qdrant, Redis, and PostgreSQL containers in background
up:
    docker compose up -d

# Stop and remove running containers
down:
    docker compose down

# Follow container logs
logs:
    docker compose logs -f

# --- Database & Ingestion Setup ---
# Initialize PostgreSQL tables
db-init:
    uv run python scripts/init_db.py

# Seed mock students, fees, and scholarships into PostgreSQL
seed:
    uv run python scripts/seed_db.py

# Parse, chunk, embed, and store student handbook in Qdrant & track in PostgreSQL
ingest:
    uv run python scripts/ingest_handbook.py

# --- Backend Application Runtimes ---
# Start FastAPI backend server with hot-reload (port 8000)
server:
    uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000

# Convenient alias for server
backend: server

# Launch Streamlit development & testing UI
streamlit:
    uv run streamlit run scripts/streamlit_app.py

# Run interactive terminal agent CLI
cli:
    uv run python app/main.py --cli

# --- Frontend Application Runtimes ---
# Start React/Vite student portal frontend dev server (port 3000)
frontend:
    cd Frontend/student-portal; npm run dev

# Convenient alias for frontend
client: frontend

# Install frontend npm dependencies
frontend-install:
    cd Frontend/student-portal; npm install

# Build frontend production bundle
frontend-build:
    cd Frontend/student-portal; npm run build

# Preview built frontend production bundle
frontend-preview:
    cd Frontend/student-portal; npm run preview

# Lint frontend codebase
frontend-lint:
    cd Frontend/student-portal; npm run lint

# --- Benchmarks & Evaluation ---
# Run 8 benchmark evaluation scenarios and output metrics table
eval:
    uv run python scripts/evaluate.py

# Audit chunk fidelity across 5 dimensions (Coverage, Metadata, Boundaries, Integrity, Tables)
audit-chunks:
    uv run python evaluation/evaluate_chunking.py

# Clean temporary log files, traces, and caches
clean:
    powershell -Command "Get-ChildItem -Path logs/*.log, traces/*.json -ErrorAction SilentlyContinue | Remove-Item -Force"
