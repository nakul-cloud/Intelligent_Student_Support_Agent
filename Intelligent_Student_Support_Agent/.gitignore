# --- Environment & Secret Keys ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
.env/

# --- Python Bytecode & Build Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing & Type Checking Caches ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- Frontend Node & Package Managers (nested inside Frontend/) ---
node_modules/
**/node_modules/
Frontend/**/node_modules/
dist/
**/dist/
Frontend/**/dist/
dist-ssr/
**/dist-ssr/
Frontend/**/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local
.eslintcache
.stylelintcache
.turbo/

# --- Observability & Runtime Logs ---
*.log
logs/*
!logs/.gitkeep

# --- Database, Vector Stores & Local Storage ---
postgres_data/
qdrant_data/
qdrant_storage/
**/qdrant_storage/
*.sqlite
*.sqlite3
*.db

# --- HuggingFace & PyTorch Cache ---
.cache/
huggingface/
checkpoints/

